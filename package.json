{
  "name": "@mlscript/tree-sitter-mlscript",
  "version": "0.1.0",
  "description": "Mlscript grammar for tree-sitter",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Derppening/tree-sitter-mlscript.git"
  },
  "funding": "",
  "license": "MIT",
  "author": {
    "name": "David Mak",
    "email": "chmakac@connect.ust.hk",
    "url": ""
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "default": "./bindings/node/index.js"
    },
    "./tree-sitter-mlscript.wasm": "./tree-sitter-mlscript.wasm",
    "./queries/*": "./queries/*",
    "./tree-sitter.json": "./tree-sitter.json",
    "./grammar.js": "./grammar.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "mlscript"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "!bindings/node/*_test.js",
    "queries/*",
    "src/**",
    "tree-sitter-mlscript.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "^0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "prebuildify": "prebuildify --napi --strip"
  },
  "publishConfig": {
    "access": "public"
  }
}
